<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- only nuget.org, independent of machine-wide sources and Visual Studio fallback folders -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
